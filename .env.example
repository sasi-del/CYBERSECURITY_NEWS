# ── Required ──────────────────────────────────────────────────────
# (none — the dashboard works without any keys)

# ── AI Summary (pick one provider, or skip both) ────────────────
# Without either key the dashboard works fine — the summary box won't appear.

# Force a specific provider: "gemini" or "openrouter"
# If omitted, auto-detects from whichever API key is set.
# AI_PROVIDER=openrouter

# Option A — Gemini
# GEMINI_API_KEY=your-key-here

# Option B — OpenRouter (OpenAI-compatible, any model on their catalog)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Server tuning ────────────────────────────────────────────────

# Port the dashboard listens on (default: 8080)
# PORT=8080

# Gunicorn worker count (default: 4, 2 is fine for <20 users)
# WORKERS=4

# Timezone for cron schedules and display (default: Asia/Kolkata)
# TZ=Asia/Kolkata

# ── Cron schedules (standard cron syntax) ────────────────────────
# When to fetch RSS feeds (default: 7:30 AM Mon–Fri)
# COLLECT_CRON=30 7 * * 1-5

# When to score + generate AI summary (default: 7:45 AM Mon–Fri)
# BULLETIN_CRON=45 7 * * 1-5
